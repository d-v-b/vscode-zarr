{
  "zarr_format": 3,
  "node_type": "array",
  "shape": [64, 64],
  "data_type": "uint8",
  "chunk_grid": { "name": "regular", "configuration": { "chunk_shape": [32, 32] } },
  "chunk_key_encoding": { "name": "default" },
  "fill_value": 0,
  "codecs": [
    {
      "name": "sharding_indexed",
      "configuration": {
        "chunk_shape": [16, 16],
        "codecs": ["bytes"],
        "index_codecs": ["bytes", { "name": "gzip", "configuration": { "level": 1 } }]
      }
    },
    {
      "name": "blosc",
      "configuration": { "cname": "lz4", "clevel": 5, "shuffle": "shuffle", "blocksize": 0 }
    },
    {
      "name": "blosc",
      "configuration": { "cname": "lz4", "clevel": 5, "shuffle": "bitshuffle", "typesize": 0, "blocksize": 0 }
    },
    {
      "name": "blosc",
      "configuration": { "cname": "lz4", "clevel": 5, "shuffle": "noshuffle", "blocksize": 0 }
    }
  ]
}
