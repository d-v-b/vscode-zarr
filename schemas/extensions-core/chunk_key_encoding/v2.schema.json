{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "v2"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "separator": {
          "type": "string",
          "enum": [
            "/",
            "."
          ]
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "separator": "."
        }
      ]
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "description": "https://zarr-specs.readthedocs.io/en/latest/v3/core/index.html#chunk-key-encoding"
}
