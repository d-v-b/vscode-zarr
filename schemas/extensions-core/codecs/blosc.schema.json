{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "blosc"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "cname": {
          "type": "string",
          "enum": [
            "lz4",
            "lz4hc",
            "blosclz",
            "snappy",
            "zlib",
            "zstd"
          ]
        },
        "clevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "shuffle": {
          "type": "string",
          "enum": [
            "noshuffle",
            "shuffle",
            "bitshuffle"
          ]
        },
        "blocksize": {
          "type": "integer",
          "minimum": 0
        },
        "typesize": {
          "type": "integer",
          "minimum": 1,
          "description": "Positive integer: the stride in bytes over which shuffling is performed. Required unless shuffle is \"noshuffle\", in which case it is ignored."
        }
      },
      "additionalProperties": false,
      "required": [
        "cname",
        "clevel",
        "shuffle",
        "blocksize"
      ],
      "examples": [
        {
          "cname": "zstd",
          "clevel": 5,
          "shuffle": "shuffle",
          "typesize": 4,
          "blocksize": 0
        }
      ],
      "if": {
        "properties": {
          "shuffle": {
            "enum": [
              "shuffle",
              "bitshuffle"
            ]
          }
        },
        "required": [
          "shuffle"
        ]
      },
      "then": {
        "required": [
          "typesize"
        ]
      }
    }
  },
  "required": [
    "name",
    "configuration"
  ],
  "additionalProperties": false,
  "description": "https://zarr-specs.readthedocs.io/en/latest/v3/codecs/blosc/index.html"
}
