{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "gzip"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        }
      },
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "examples": [
        {
          "level": 5
        }
      ]
    }
  },
  "required": [
    "name",
    "configuration"
  ],
  "additionalProperties": false,
  "description": "https://zarr-specs.readthedocs.io/en/latest/v3/codecs/gzip/index.html"
}
