{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "const": "regular"
    },
    "configuration": {
      "type": "object",
      "properties": {
        "chunk_shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "\"Chunk sizes must be greater than zero.\" https://github.com/zarr-developers/zarr-specs/blob/fc7dd9c9beb5a50b87f9b08b00bf50fc0048482f/docs/v3/chunk-grids/regular-grid/index.rst#L40"
        }
      },
      "additionalProperties": false,
      "required": [
        "chunk_shape"
      ],
      "examples": [
        {
          "chunk_shape": [
            64,
            64
          ]
        }
      ]
    }
  },
  "required": [
    "name",
    "configuration"
  ],
  "additionalProperties": false,
  "description": "https://zarr-specs.readthedocs.io/en/latest/v3/core/index.html#regular-grids"
}
